{
  "name": "oh-my-stock",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch server/index.ts",
    "build": "tsc --noEmit && vite build",
    "start": "tsx server/index.ts --production",
    "test": "tsx --test tests/*.test.ts",
    "check:toss": "tsx scripts/check-toss.ts",
    "check:ai": "tsx scripts/check-ai.ts",
    "check:research": "tsx scripts/check-research.ts",
    "check:daily": "tsx scripts/check-daily.ts",
    "format": "prettier --write src server shared scripts tests analysis-skills"
  },
  "dependencies": {
    "decimal.js": "10.6.0",
    "dotenv": "17.2.1",
    "express": "5.1.0",
    "fast-xml-parser": "5.11.1",
    "lucide-react": "0.468.0",
    "react": "19.1.1",
    "react-dom": "19.1.1",
    "ws": "^8.21.3",
    "zod": "4.1.5"
  },
  "devDependencies": {
    "@anthropic-ai/claude-code": "^2.1.260",
    "@openai/codex": "^0.153.2",
    "@types/express": "5.0.3",
    "@types/node": "24.3.0",
    "@types/react": "19.1.10",
    "@types/react-dom": "19.1.9",
    "@types/ws": "^8.18.1",
    "@vitejs/plugin-react": "5.0.2",
    "prettier": "^3.9.6",
    "tsx": "4.20.5",
    "typescript": "5.9.2",
    "vite": "7.3.5"
  },
  "engines": {
    "node": ">=24.0.0"
  },
  "packageManager": "pnpm@11.19.0"
}
