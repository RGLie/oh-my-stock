TOSS_CLIENT_ID=
TOSS_CLIENT_SECRET=
# Optional: choose one account in the UI when multiple accounts exist.
TOSS_ACCOUNT_SEQ=
PORT=4310
# Absolute executable paths if the CLIs are not on PATH.
CODEX_CLI_PATH=
CLAUDE_CLI_PATH=
# Optional cloud mode: both values are required. Keep blank for this PC.
# Use the exact Tailscale Serve HTTPS address and your Tailscale login.
OMS_REMOTE_ORIGIN=
OMS_REMOTE_USER=
# Optional Telegram bot (long polling, no public port). Create a bot with @BotFather, paste the token,
# start the server, send the bot any message: it replies with your chat ID. Put that ID here and restart.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
# Optional e-mail delivery. Gmail: SMTP_USER is your address, SMTP_PASS a 16-character app password
# (Google account > Security > 2-Step Verification > App passwords). Other servers: set host and port.
SMTP_USER=
SMTP_PASS=
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
# Optional: defaults to SMTP_USER. Set the recipient in the app's settings screen if it differs.
MAIL_FROM=
MAIL_TO=
